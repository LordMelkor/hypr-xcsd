#!/bin/sh
# Verify that a Hyprland binary still exports, with exactly the expected
# signatures, the functions hypr-xcsd hooks (see hook-signatures.hpp). The
# plugin refuses to load on a mismatch; this finds it before you update.
#
# Usage: scripts/check-hook-symbols [path/to/Hyprland]   (default /usr/bin/Hyprland)
set -eu
bin=${1:-/usr/bin/Hyprland}
here=$(dirname "$0")/..
symbols=$(nm -D --defined-only "$bin" | c++filt | sed -n 's/^[0-9a-f]* [TtWw] //p')
defs=$(grep -cE '^[[:space:]]*#[[:space:]]*define[[:space:]]+SIG_' "$here/hook-signatures.hpp" || true)
sigs=$(sed -nE 's/^[[:space:]]*#[[:space:]]*define[[:space:]]+SIG_[A-Z_]+[[:space:]]+"(.*)"[[:space:]]*$/\1/p' "$here/hook-signatures.hpp")
parsed=$(printf '%s\n' "$sigs" | grep -c . || true)
if [ "$defs" -eq 0 ] || [ "$parsed" -ne "$defs" ]; then
  echo "could not parse every SIG_ definition in hook-signatures.hpp ($parsed of $defs)"
  exit 1
fi
status=0
for sig in $(printf '%s\n' "$sigs" | tr ' ' '\037'); do
  sig=$(printf '%s' "$sig" | tr '\037' ' ')
  count=$(printf '%s\n' "$symbols" | grep -cxF -- "$sig" || true)
  if [ "$count" -eq 1 ]; then
    echo "ok       $sig"
  else
    echo "MISSING  $sig (found $count)"
    status=1
  fi
done
exit $status
