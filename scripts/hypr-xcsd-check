#!/usr/bin/env python3
"""Observe hyprpm state and actual loaded presence; never build/load/retry."""
import json
import os
from pathlib import Path
import pwd
import subprocess
import sys
import tomllib


def assess(repo, cache_abi, installed_abi, running_abi, loaded):
    plugin = repo.get('hypr-xcsd', {})
    if not plugin.get('enabled', False):
        return 0, 'hypr-xcsd is disabled; no load expected.'
    if plugin.get('failed', False):
        return 1, 'hypr-xcsd build failed. Fix the source and run hyprpm update.'
    if cache_abi != running_abi:
        if cache_abi and cache_abi == installed_abi:
            return 2, 'hypr-xcsd is built for installed Hyprland. Start a new session to load it.'
        return 1, 'hypr-xcsd headers/build are stale. Run hyprpm update, then restart the session if required.'
    if 'hypr-xcsd' not in loaded:
        return 1, 'hypr-xcsd is enabled but not loaded. Inspect hyprctl configerrors and plugin-load output.'
    return 0, 'hypr-xcsd is loaded. This checks presence, not behavior or code replacement.'


def json_command(*args):
    return json.loads(subprocess.check_output(args, text=True, stderr=subprocess.PIPE, timeout=10))


def check():
    base = Path('/var/cache/hyprpm') / pwd.getpwuid(os.getuid()).pw_name
    repo = tomllib.loads((base / 'hypr-xcsd/state.toml').read_text())
    if not repo.get('hypr-xcsd', {}).get('enabled', False):
        return 0, 'hypr-xcsd is disabled; no load expected.'
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        return 2, 'No Hyprland session selected. Enabled plugins will be checked at the next login.'
    cache = tomllib.loads((base / 'state.toml').read_text())['state']['hash']
    installed = json_command('Hyprland', '--version-json')['abiHash']
    running = json_command('hyprctl', '-j', 'version')['abiHash']
    loaded = {p['name'] for p in json_command('hyprctl', '-j', 'plugin', 'list')}
    return assess(repo, cache, installed, running, loaded)


def main():
    try:
        status, message = check()
    except (OSError, KeyError, ValueError, subprocess.SubprocessError) as e:
        status, message = 1, f'Cannot verify hypr-xcsd: {e}. Check hyprpm registration and the current session.'
    print(message)
    if status and '--notify' in sys.argv:
        try:
            subprocess.run(['notify-send', 'Hyprland plugin needs attention', message], check=False, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass  # the console message and exit status remain available
    return status


if __name__ == '__main__':
    raise SystemExit(main())
